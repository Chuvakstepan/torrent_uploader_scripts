// ==UserScript==
// @name         Kinozal(.tv/.me) to Torrent Upload
// @namespace    http://tampermonkey.net/
// @version      2.51
// @description  Заменяет текст на гиперссылку для отправки торрента или magnet-ссылки на локальный сервер
// @author       Chuvakstepan, DeepSeek
// @match        https://kinozal.tv/details.php?id=*
// @match        https://kinozal.me/details.php?id=*
// @grant        GM_xmlhttpRequest
// @grant        GM_download
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_registerMenuCommand
// @connect       192.168.1.133
// @connect       192.168.1.133:8090
// @connect       192.168.1.1
// @connect       10.*
// @connect       172.16.*.*
// @connect       localhost
// @connect       127.0.0.1
// @connect       dl.kinozal.tv
// @connect       dl.kinozal.me
// @connect       kinozal.tv
// @connect       kinozal.me
// @connect       i4.imageban.ru
// @connect       i127.fastpic.org
// @connect       fastpic.org
// @run-at       document-end
// ==/UserScript==

(function() {
    'use strict';

    console.log('=== Скрипт Kinozal Uploader v2.51 запущен ===');

    const DEFAULT_SERVER_URL = 'http://192.168.1.133:8090';
    const LOCAL_POSTER_SCRIPT = 'http://192.168.1.133/postimg.php';

    // Определяем текущий домен
    function getCurrentDomain() {
        const hostname = window.location.hostname;
        if (hostname.includes('kinozal.tv')) return 'kinozal.tv';
        if (hostname.includes('kinozal.me')) return 'kinozal.me';
        return hostname;
    }

    const CURRENT_DOMAIN = getCurrentDomain();
    console.log(`🌐 Текущий домен: ${CURRENT_DOMAIN}`);

    // Функции для работы с настройками
    function getServerUrl() {
        return GM_getValue('server_url', DEFAULT_SERVER_URL);
    }

    function setServerUrl(url) {
        GM_setValue('server_url', url);
        console.log('✅ Адрес сервера обновлен на:', url);
    }

    // Добавляем пункт в меню Tampermonkey
    GM_registerMenuCommand('⚙️ Настроить адрес сервера', function() {
        const currentUrl = getServerUrl();
        const newUrl = prompt('Введите адрес сервера (с портом):\nПример: http://192.168.1.133:8090', currentUrl);
        if (newUrl && newUrl.trim()) {
            let url = newUrl.trim();
            if (!url.startsWith('http://') && !url.startsWith('https://')) {
                url = 'http://' + url;
            }
            setServerUrl(url);
            alert('✅ Адрес сервера обновлен на: ' + url);
            location.reload();
        }
    });

    // Функция для получения ID раздачи из URL
    function getTorrentId() {
        const urlParams = new URLSearchParams(window.location.search);
        return urlParams.get('id');
    }

    // Функция для получения заголовка раздачи
    function getTorrentTitle() {
        const ogTitle = document.querySelector('meta[property="og:title"]');
        if (ogTitle) {
            const title = ogTitle.getAttribute('content');
            if (title) {
                console.log('✅ Title из og:title:', title);
                return title;
            }
        }

        const productName = document.querySelector('[itemprop="name"]');
        if (productName) {
            const title = productName.getAttribute('content');
            if (title) {
                console.log('✅ Title из schema.org Product:', title);
                return title;
            }
        }

        const h1Title = document.querySelector('h1 a.r1, h1 a.r0');
        if (h1Title) {
            const title = h1Title.textContent.trim();
            if (title) {
                console.log('✅ Title из h1:', title);
                return title;
            }
        }

        const pageTitle = document.querySelector('title');
        if (pageTitle) {
            let title = pageTitle.textContent.trim();
            title = title.replace(/:: Кинозал\.(ТВ|me)$/, '').trim();
            if (title) {
                console.log('✅ Title из title страницы:', title);
                return title;
            }
        }

        console.log('❌ Title не найден');
        return '';
    }

    // Функция для получения URL постера
    function getPosterUrl() {
        const ogImage = document.querySelector('meta[property="og:image"]');
        if (ogImage) {
            let url = ogImage.getAttribute('content');
            if (url) {
                if (url.startsWith('/')) {
                    url = `https://${CURRENT_DOMAIN}` + url;
                    console.log('✅ Постер из og:image (относительный):', url);
                    return url;
                }
                if (url.startsWith('http')) {
                    console.log('✅ Постер из og:image (абсолютный):', url);
                    return url;
                }
            }
        }

        const menuImage = document.querySelector('.mn1_menu .p200');
        if (menuImage) {
            let src = menuImage.src;
            if (src) {
                if (src.startsWith('/')) {
                    src = `https://${CURRENT_DOMAIN}` + src;
                    console.log('✅ Постер из меню (относительный):', src);
                    return src;
                }
                if (src.startsWith('http')) {
                    console.log('✅ Постер из меню (абсолютный):', src);
                    return src;
                }
            }
        }

        const posterImg = document.querySelector('img[src*="/i/poster/"]');
        if (posterImg) {
            let src = posterImg.src;
            if (src) {
                if (src.startsWith('/')) {
                    src = `https://${CURRENT_DOMAIN}` + src;
                    console.log('✅ Постер найден по пути /i/poster/:', src);
                    return src;
                }
                if (src.startsWith('http')) {
                    console.log('✅ Постер найден по пути /i/poster/ (абсолютный):', src);
                    return src;
                }
            }
        }

        console.log('❌ Постер не найден');
        return '';
    }

    // Функция для получения URL скачивания торрента
    function getDownloadUrl() {
        const downloadLink = document.querySelector(`a[href*="dl.${CURRENT_DOMAIN}/download.php"]`);
        if (downloadLink) {
            return downloadLink.href;
        }
        return null;
    }

    // Функция для скачивания торрента через GM_xmlhttpRequest
    function downloadTorrentGM(url) {
        return new Promise((resolve, reject) => {
            console.log('📥 Скачивание торрента с URL:', url);

            GM_xmlhttpRequest({
                method: 'GET',
                url: url,
                responseType: 'blob',
                withCredentials: true,
                headers: {
                    'User-Agent': navigator.userAgent,
                    'Accept': 'application/x-bittorrent, application/octet-stream, */*',
                    'Referer': window.location.href
                },
                onload: function(response) {
                    console.log('📥 Ответ получен, статус:', response.status);
                    if (response.status === 200) {
                        console.log('📥 Торрент скачан, размер:', response.response.size, 'байт');
                        resolve(response.response);
                    } else {
                        reject(new Error(`HTTP ${response.status}: ${response.statusText}`));
                    }
                },
                onerror: function(error) {
                    console.error('❌ Ошибка при скачивании торрента:', error);
                    reject(new Error('Ошибка сети при скачивании торрента'));
                },
                ontimeout: function() {
                    reject(new Error('Таймаут при скачивании торрента'));
                },
                timeout: 30000
            });
        });
    }

    // Функция: Загрузка постера на локальный сервер
    function uploadPosterToLocal(posterUrl) {
        return new Promise((resolve) => {
            console.log('🖼️ Загрузка постера на локальный сервер:', posterUrl);

            const encodedUrl = encodeURIComponent(posterUrl);
            const requestUrl = LOCAL_POSTER_SCRIPT + '?url=' + encodedUrl;

            console.log('🔄 Запрос к:', requestUrl);

            GM_xmlhttpRequest({
                method: 'GET',
                url: requestUrl,
                onload: function(response) {
                    console.log('📥 Ответ от postimg.php: статус', response.status);
                    console.log('📥 Тело ответа:', response.responseText);

                    if (response.status === 200) {
                        try {
                            const jsonResponse = JSON.parse(response.responseText);
                            console.log('📥 Распарсенный ответ:', jsonResponse);

                            if (jsonResponse.success && jsonResponse.url) {
                                console.log('✅ Постер загружен локально:', jsonResponse.url);
                                resolve(jsonResponse.url);
                            } else if (jsonResponse.error) {
                                console.warn('⚠️ Ошибка загрузки постера:', jsonResponse.error);
                                resolve(posterUrl);
                            } else {
                                console.warn('⚠️ Неизвестный ответ, используем оригинальный постер');
                                resolve(posterUrl);
                            }
                        } catch (e) {
                            console.warn('⚠️ Ошибка парсинга JSON:', e.message);
                            resolve(posterUrl);
                        }
                    } else {
                        console.warn('⚠️ Локальный сервер вернул статус ' + response.status + ', используем оригинальный постер');
                        resolve(posterUrl);
                    }
                },
                onerror: function(error) {
                    console.warn('⚠️ Ошибка соединения с локальным сервером, используем оригинальный постер:', error);
                    resolve(posterUrl);
                },
                ontimeout: function() {
                    console.warn('⚠️ Таймаут соединения с локальным сервером, используем оригинальный постер');
                    resolve(posterUrl);
                },
                timeout: 10000
            });
        });
    }

    // Функция для отправки торрента на сервер
    function uploadTorrent(blob, torrentName, title, posterUrl) {
        return new Promise((resolve, reject) => {
            const formData = new FormData();
            formData.append('file', blob, torrentName);
            formData.append('save', 'true');
            if (title) {
                formData.append('title', title);
            }
            if (posterUrl) {
                formData.append('poster', posterUrl);
            }

            console.log('📤 ОТПРАВКА ЗАПРОСА:');
            console.log('📤 URL:', getServerUrl() + '/torrent/upload');
            console.log('📤 Метод: POST');
            console.log('📤 Параметры формы:');
            console.log('  file:', torrentName, `(${blob.size} байт)`);
            console.log('  save: true');
            console.log('  title:', title || '(пусто)');
            console.log('  poster:', posterUrl || '(пусто)');

            GM_xmlhttpRequest({
                method: 'POST',
                url: getServerUrl() + '/torrent/upload',
                headers: {
                    'Accept': 'application/json'
                },
                data: formData,
                onload: function(response) {
                    console.log('📥 ОТВЕТ СЕРВЕРА:');
                    console.log('📥 Статус:', response.status);
                    console.log('📥 Тело ответа:', response.responseText);

                    if (response.status === 200 || response.status === 201) {
                        try {
                            const jsonResponse = JSON.parse(response.responseText);
                            console.log('✅ Ответ сервера (JSON):', jsonResponse);
                            resolve(jsonResponse);
                        } catch (e) {
                            console.log('✅ Ответ сервера (текст):', response.responseText);
                            resolve(response.responseText);
                        }
                    } else {
                        reject(new Error(`HTTP ${response.status}: ${response.statusText}`));
                    }
                },
                onerror: function(error) {
                    console.error('❌ Ошибка отправки на сервер:', error);
                    reject(new Error('Ошибка сети при отправке на сервер'));
                },
                ontimeout: function() {
                    reject(new Error('Таймаут при отправке на сервер'));
                },
                timeout: 30000
            });
        });
    }

    // Функция для отправки magnet-ссылки на сервер
    function uploadMagnet(magnetLink, title, posterUrl) {
        return new Promise((resolve, reject) => {
            const serverUrl = getServerUrl();

            console.log('📤 ОТПРАВКА MAGNET-ССЫЛКИ:');
            console.log('📤 URL:', serverUrl + '/torrents');

            const jsonData = {
                'action': 'add',
                'link': magnetLink,
                'title': title || '',
                'poster': posterUrl || '',
                'save_to_db': true
            };

            console.log('📤 Данные:', jsonData);

            GM_xmlhttpRequest({
                method: 'POST',
                url: serverUrl + '/torrents',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                data: JSON.stringify(jsonData),
                onload: function(response) {
                    console.log('📥 ОТВЕТ СЕРВЕРА:');
                    console.log('📥 Статус:', response.status);
                    console.log('📥 Тело ответа:', response.responseText);

                    if (response.status === 200 || response.status === 201) {
                        try {
                            const jsonResponse = JSON.parse(response.responseText);
                            console.log('✅ Ответ сервера (JSON):', jsonResponse);
                            resolve(jsonResponse);
                        } catch (e) {
                            console.log('✅ Ответ сервера (текст):', response.responseText);
                            resolve(response.responseText);
                        }
                    } else {
                        reject(new Error(`HTTP ${response.status}: ${response.statusText}`));
                    }
                },
                onerror: function(error) {
                    console.error('❌ Ошибка отправки на сервер:', error);
                    reject(new Error('Ошибка сети при отправке на сервер'));
                },
                ontimeout: function() {
                    reject(new Error('Таймаут при отправке на сервер'));
                },
                timeout: 30000
            });
        });
    }

    // Функция получения info_hash через "Список файлов" (резервный метод)
    function getInfoHashFromFileList() {
        return new Promise((resolve, reject) => {
            console.log('🔍 Резервный метод: получение info_hash через "Список файлов"...');

            // Находим кнопку "Список файлов"
            const fileListBtn = document.querySelector('a[onclick*="get_torm"][onclick*=",2,"]') ||
                               Array.from(document.querySelectorAll('a')).find(a => a.textContent.includes('Список файлов'));

            if (!fileListBtn) {
                reject(new Error('Кнопка "Список файлов" не найдена'));
                return;
            }

            console.log('✅ Кнопка "Список файлов" найдена');

            // Создаем Promise для ожидания появления info_hash
            const infoHashPromise = new Promise((resolveHash) => {
                // Проверяем, не появился ли уже контейнер с информацией
                const container = document.getElementById('container');
                if (container && container.style.display !== 'none') {
                    const containerData = document.getElementById('containerdata');
                    if (containerData) {
                        const text = containerData.textContent || containerData.innerText;
                        const hashMatch = text.match(/Инфо хеш:\s*([A-Fa-f0-9]{40})/i);
                        if (hashMatch && hashMatch[1]) {
                            resolveHash(hashMatch[1].toUpperCase());
                            return;
                        }
                    }
                }

                // Устанавливаем MutationObserver для отслеживания изменений
                const observer = new MutationObserver(function(mutations) {
                    for (const mutation of mutations) {
                        const containerData = document.getElementById('containerdata');
                        if (containerData) {
                            const text = containerData.textContent || containerData.innerText;
                            const hashMatch = text.match(/Инфо хеш:\s*([A-Fa-f0-9]{40})/i);
                            if (hashMatch && hashMatch[1]) {
                                console.log('✅ Найден info_hash в containerdata:', hashMatch[1]);
                                observer.disconnect();
                                resolveHash(hashMatch[1].toUpperCase());
                                return;
                            }
                        }
                    }
                });

                observer.observe(document.body, {
                    childList: true,
                    subtree: true
                });

                // Таймаут
                setTimeout(() => {
                    observer.disconnect();
                    resolveHash(null);
                }, 10000);
            });

            // Эмулируем клик по кнопке
            fileListBtn.click();
            console.log('🔄 Клик по "Список файлов" выполнен, ожидаем info_hash...');

            // Ждем появления info_hash
            infoHashPromise.then(hash => {
                if (hash) {
                    resolve(hash);
                } else {
                    reject(new Error('Не удалось получить info_hash через "Список файлов"'));
                }
            });
        });
    }

    // Основная функция
    function replaceTextWithLink() {
        console.log(`🔍 Поиск td с кнопкой скачивания на ${CURRENT_DOMAIN}...`);

        const downloadTd = document.querySelector(`td.nw a[href*="dl.${CURRENT_DOMAIN}/download.php"]`);
        if (!downloadTd) {
            console.log('❌ TD с кнопкой скачивания не найден');
            return;
        }

        const parentTd = downloadTd.closest('td.nw');
        if (!parentTd) {
            console.log('❌ Родительский td не найден');
            return;
        }

        console.log('✅ Найден td с кнопкой скачивания');

        const nextTd = parentTd.nextElementSibling;
        if (!nextTd || nextTd.tagName !== 'TD') {
            console.log('❌ Следующий td не найден');
            return;
        }

        console.log('✅ Найден следующий td с текстом');

        if (document.getElementById('torrent-upload-link-container')) {
            console.log('⚠️ Ссылка уже существует');
            return;
        }

        const torrentId = getTorrentId();
        const torrentTitle = getTorrentTitle();
        const posterUrl = getPosterUrl();
        const downloadUrl = getDownloadUrl();

        console.log('📋 Данные раздачи:');
        console.log('  ID:', torrentId);
        console.log('  Title:', torrentTitle || '(пусто)');
        console.log('  Poster URL:', posterUrl || '(пусто)');
        console.log('  Download URL:', downloadUrl || '(пусто)');

        if (!torrentId) {
            console.log('❌ Не удалось получить ID раздачи');
            return;
        }

        nextTd.innerHTML = '';

        const linkContainer = document.createElement('div');
        linkContainer.id = 'torrent-upload-link-container';
        linkContainer.style.cssText = `
display: flex;
align-items: center;
justify-content: flex-start;
gap: 10px;
padding: 2px 0;
flex-wrap: wrap;
        `;

        const uploadLink = document.createElement('a');
        uploadLink.id = 'torrent-upload-link';
        uploadLink.href = '#';
        uploadLink.style.cssText = `
            display: inline-block;
            color: #0066cc;
            font-size: 13px;
            font-weight: 700;
            text-decoration: underline;
            cursor: pointer;
            padding: 3px 10px;
            transition: all 0.2s ease;
            background: #f0f8ff;
            border-radius: 3px;
            border: 1px solid #b8d4f0;
            white-space: nowrap;
            line-height: 20px;
        `;
        uploadLink.textContent = '📤 Отправить на сервер';

        uploadLink.onmouseover = function() {
            this.style.color = '#ff6b00';
            this.style.background = '#fff0e6';
            this.style.borderColor = '#ff6b00';
        };
        uploadLink.onmouseout = function() {
            this.style.color = '#0066cc';
            this.style.background = '#f0f8ff';
            this.style.borderColor = '#b8d4f0';
        };

        const statusDiv = document.createElement('div');
        statusDiv.id = 'torrent-upload-status-link';
        statusDiv.style.cssText = `
            font-size: 12px;
            color: #333;
            display: none;
            padding: 2px 8px;
            border-radius: 3px;
            background: #f8f9fa;
            border: 1px solid #ddd;
            white-space: nowrap;
            line-height: 20px;
            transition: all 0.3s ease;
        `;

        linkContainer.appendChild(uploadLink);
        linkContainer.appendChild(statusDiv);
        nextTd.appendChild(linkContainer);

        console.log('✅ Текст заменен на гиперссылку');

        // Обработчик клика
        uploadLink.addEventListener('click', async function(e) {
            e.preventDefault();

            const statusDiv = document.getElementById('torrent-upload-status-link');
            statusDiv.style.display = 'inline-block';
            statusDiv.innerHTML = '⏳ Скачивание...';
            statusDiv.style.background = '#fff3cd';
            statusDiv.style.borderColor = '#ffc107';

            uploadLink.textContent = '⏳ Загрузка...';
            uploadLink.style.cursor = 'wait';
            uploadLink.onmouseover = null;
            uploadLink.onmouseout = null;

            try {
                let result;
                let usedMethod = '';

                // ========== МЕТОД 1: Скачивание .torrent файла ==========
                if (downloadUrl) {
                    try {
                        console.log('📥 Метод 1: Попытка скачать .torrent файл...');
                        statusDiv.innerHTML = '⏳ Скачивание торрента...';
                        statusDiv.style.background = '#fff3cd';
                        statusDiv.style.borderColor = '#ffc107';

                        const blob = await downloadTorrentGM(downloadUrl);
                        console.log('✅ Торрент успешно скачан, размер:', blob.size);

                        statusDiv.innerHTML = '⏳ Обработка постера...';
                        statusDiv.style.background = '#cce5ff';
                        statusDiv.style.borderColor = '#b8daff';

                        let finalPosterUrl = posterUrl;
                        if (posterUrl) {
                            finalPosterUrl = await uploadPosterToLocal(posterUrl);
                            if (finalPosterUrl === posterUrl) {
                                console.log('ℹ️ Используется оригинальный постер с внешнего сервера');
                            } else {
                                console.log('✅ Постер загружен локально:', finalPosterUrl);
                            }
                        }

                        statusDiv.innerHTML = '⏳ Отправка торрента...';
                        statusDiv.style.background = '#cce5ff';
                        statusDiv.style.borderColor = '#b8daff';

                        const torrentName = `[${CURRENT_DOMAIN}]id${torrentId}.torrent`;
                        result = await uploadTorrent(blob, torrentName, torrentTitle, finalPosterUrl);
                        usedMethod = 'TORRENT';
                        console.log('✅ Торрент успешно отправлен!', result);

                    } catch (torrentError) {
                        console.warn('⚠️ Метод 1 (скачивание .torrent) не сработал:', torrentError.message);

                        // ========== МЕТОД 2: Magnet через "Список файлов" ==========
                        console.log('🔄 Метод 2: Пробуем через magnet (Список файлов)...');
                        statusDiv.innerHTML = '⏳ Получение magnet-ссылки...';
                        statusDiv.style.background = '#fff3cd';
                        statusDiv.style.borderColor = '#ffc107';

                        try {
                            const infoHash = await getInfoHashFromFileList();
                            console.log('✅ Info_hash получен:', infoHash);

                            // Формируем magnet-ссылку
                            const title = encodeURIComponent(torrentTitle || '');
                            const magnetLink = `magnet:?xt=urn:btih:${infoHash}&tr=http://bt2.t-ru.org/ann?magnet&dn=${title}`;
                            console.log('✅ Magnet-ссылка сформирована:', magnetLink);

                            statusDiv.innerHTML = '⏳ Обработка постера...';
                            statusDiv.style.background = '#cce5ff';
                            statusDiv.style.borderColor = '#b8daff';

                            let finalPosterUrl = posterUrl;
                            if (posterUrl) {
                                finalPosterUrl = await uploadPosterToLocal(posterUrl);
                                if (finalPosterUrl === posterUrl) {
                                    console.log('ℹ️ Используется оригинальный постер с внешнего сервера');
                                } else {
                                    console.log('✅ Постер загружен локально:', finalPosterUrl);
                                }
                            }

                            statusDiv.innerHTML = '⏳ Отправка magnet-ссылки...';
                            statusDiv.style.background = '#cce5ff';
                            statusDiv.style.borderColor = '#b8daff';

                            result = await uploadMagnet(magnetLink, torrentTitle, finalPosterUrl);
                            usedMethod = 'MAGNET';
                            console.log('✅ Magnet-ссылка успешно отправлена!', result);

                        } catch (magnetError) {
                            console.error('❌ Метод 2 (magnet) тоже не сработал:', magnetError.message);
                            throw new Error('Не удалось отправить раздачу. Попробуйте обновить страницу.');
                        }
                    }
                } else {
                    // Если нет ссылки на скачивание, сразу пробуем magnet
                    console.log('ℹ️ Ссылка на скачивание отсутствует, пробуем magnet...');
                    const infoHash = await getInfoHashFromFileList();
                    console.log('✅ Info_hash получен:', infoHash);

                    const title = encodeURIComponent(torrentTitle || '');
                    const magnetLink = `magnet:?xt=urn:btih:${infoHash}&tr=http://bt2.t-ru.org/ann?magnet&dn=${title}`;
                    console.log('✅ Magnet-ссылка сформирована:', magnetLink);

                    statusDiv.innerHTML = '⏳ Обработка постера...';
                    statusDiv.style.background = '#cce5ff';
                    statusDiv.style.borderColor = '#b8daff';

                    let finalPosterUrl = posterUrl;
                    if (posterUrl) {
                        finalPosterUrl = await uploadPosterToLocal(posterUrl);
                        if (finalPosterUrl === posterUrl) {
                            console.log('ℹ️ Используется оригинальный постер с внешнего сервера');
                        } else {
                            console.log('✅ Постер загружен локально:', finalPosterUrl);
                        }
                    }

                    statusDiv.innerHTML = '⏳ Отправка magnet-ссылки...';
                    statusDiv.style.background = '#cce5ff';
                    statusDiv.style.borderColor = '#b8daff';

                    result = await uploadMagnet(magnetLink, torrentTitle, finalPosterUrl);
                    usedMethod = 'MAGNET';
                    console.log('✅ Magnet-ссылка успешно отправлена!', result);
                }

                // Успешное завершение
                statusDiv.innerHTML = `✅ Отправлен! (${usedMethod})`;
                statusDiv.style.background = '#d4edda';
                statusDiv.style.borderColor = '#c3e6cb';
                statusDiv.style.color = 'green';
                console.log(`✅ Раздача успешно отправлена (метод: ${usedMethod})!`, result);

            } catch (error) {
                console.error('❌ Ошибка:', error);
                statusDiv.innerHTML = '❌ ' + error.message;
                statusDiv.style.background = '#f8d7da';
                statusDiv.style.borderColor = '#f5c6cb';
                statusDiv.style.color = 'red';
                statusDiv.title = error.message || 'Неизвестная ошибка';
            } finally {
                uploadLink.textContent = '📤 Отправить на сервер';
                uploadLink.style.cursor = 'pointer';
                uploadLink.onmouseover = function() {
                    this.style.color = '#ff6b00';
                    this.style.background = '#fff0e6';
                    this.style.borderColor = '#ff6b00';
                };
                uploadLink.onmouseout = function() {
                    this.style.color = '#0066cc';
                    this.style.background = '#f0f8ff';
                    this.style.borderColor = '#b8d4f0';
                };

                setTimeout(() => {
                    statusDiv.style.opacity = '0';
                    setTimeout(() => {
                        statusDiv.style.display = 'none';
                        statusDiv.style.opacity = '1';
                    }, 300);
                }, 3000);
            }
        });
    }

    // Инициализация
    function init() {
        console.log(`🚀 Инициализация скрипта для ${CURRENT_DOMAIN} (v2.51)...`);
        console.log('📋 Стратегия: сначала .torrent, при ошибке - magnet через "Список файлов"');
        setTimeout(replaceTextWithLink, 1500);
        setTimeout(replaceTextWithLink, 3000);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }

    const observer = new MutationObserver(function(mutations) {
        if (!document.getElementById('torrent-upload-link-container')) {
            console.log('🔄 Ссылка не найдена, пробуем добавить...');
            replaceTextWithLink();
        }
    });
    observer.observe(document.body, { childList: true, subtree: true });

})();
